# Giữ nguyên X-Forwarded-Proto do lớp proxy phía trước đặt; chỉ khi không có
# thì mới dùng $scheme của chính nginx.
#
# Vì sao cần: trên PaaS, TLS kết thúc ở ingress của nền tảng rồi chuyển HTTP
# xuống container này, nên $scheme ở đây luôn là "http". Nếu đè cứng
# `X-Forwarded-Proto $scheme` thì Spring dựng redirect_uri của Google thành
# "http://domain/..." trong khi Google đã đăng ký "https://domain/..."
# -> redirect_uri_mismatch. Chạy local không có header này nên rơi về $scheme,
# hành vi y như cũ.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Chặn payload quá lớn ngay tại lớp proxy, trước khi chạm tới backend.
    client_max_body_size 256k;

    # Khai báo ở cấp server để mọi location proxy bên dưới cùng kế thừa,
    # khỏi lặp lại và khỏi quên ở một location nào đó.
    # $http_host chứ không phải $host: $host CẮT MẤT PORT. Spring dựng
    # redirect_uri của Google từ header Host, dùng $host thì ở local ra
    # "http://localhost/login/oauth2/code/google" (thiếu :5173) và Google báo
    # redirect_uri_mismatch. Với domain thật chạy cổng 443 thì hai biến cho
    # kết quả như nhau.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    # BACKEND_URL do entrypoint của image nginx thay vào lúc container khởi
    # động (xem Dockerfile). Mặc định là "http://backend:8080" — tên service
    # trong docker-compose.yml. Khi deploy lên PaaS (Northflank...) thì set
    # biến này thành địa chỉ nội bộ mà nền tảng cấp cho service backend.
    #
    # Lưu ý vận hành: nginx phân giải DNS của upstream ngay lúc KHỞI ĐỘNG.
    # Nếu backend chưa chạy/chưa có DNS thì nginx thoát với lỗi
    # "host not found in upstream" và container lặp restart. Trên PaaS phải
    # deploy backend trước, hoặc để nền tảng tự retry.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
    }

    # Hai block dưới đây BẮT BUỘC cho đăng nhập Google, và chỉ cần khi nginx
    # là cổng public duy nhất (trường hợp deploy lên PaaS).
    #
    #   /oauth2/authorization/google  -> Spring bắt đầu luồng OAuth
    #   /login/oauth2/code/google     -> Google gọi ngược lại sau khi user đồng ý
    #
    # Thiếu chúng thì request rơi xuống "location /" và bị try_files trả về
    # index.html: trình duyệt nhận HTML thay vì redirect, SPA load lại như
    # chưa có gì xảy ra — hỏng mà không có thông báo lỗi nào.
    #
    # PHẢI ghi đủ "/oauth2/authorization/", KHÔNG được rút gọn thành "/oauth2/":
    # frontend có route riêng "/oauth2/redirect" (App.jsx) là trang React nhận
    # token sau khi đăng nhập xong. Bắt cả "/oauth2/" thì đường đó bị đẩy sang
    # backend, backend không có route nên trả 500 JSON thay vì trang SPA —
    # đăng nhập Google hỏng đúng ở bước cuối cùng.
    location /oauth2/authorization/ {
        proxy_pass ${BACKEND_URL}/oauth2/authorization/;
    }

    location /login/oauth2/ {
        proxy_pass ${BACKEND_URL}/login/oauth2/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
