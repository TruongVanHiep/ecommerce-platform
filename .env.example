# Copy this file to .env and fill in real values. .env is gitignored.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=e_commerce_mini

# --- Backend ---
DB_USERNAME=root
DB_PASSWORD=changeme
JWT_SIGNER_KEY=change-this-to-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# Mật khẩu admin khởi tạo (bỏ trống => không seed tài khoản admin nào)
ADMIN_INIT_PASSWORD=

# ===== Chỉ dùng khi deploy production (docker-compose.prod.yml) =====
# Domain đã trỏ A record về IP VPS. Caddy dùng để xin chứng chỉ HTTPS.
DOMAIN=shop.example.com
GRAFANA_DOMAIN=grafana.example.com

# Ghi đè tự động trong docker-compose.prod.yml theo DOMAIN ở trên,
# chỉ khai báo tay khi frontend chạy ở domain khác backend.
# APP_PUBLIC_URL=https://shop.example.com
# APP_CORS_ORIGINS=https://shop.example.com
